# Required. Never commit the real value.
OPENAI_API_KEY=sk-your-key-here

# Optional: point at a compatible gateway (Azure OpenAI proxy, LiteLLM, ...).
OPENAI_BASE_URL=https://api.openai.com/v1

# Models per pipeline stage.
MODEL_EXTRACTION=gpt-4o-mini
MODEL_ANALYSIS=gpt-4o-mini
MODEL_IDEAS=gpt-4o-mini
MODEL_RANKING=gpt-4o

# LLM transport.
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=4
LLM_CONCURRENCY=4

# Browser.
SHOW_BROWSER=1
NAV_TIMEOUT_MS=20000
MAX_SCROLLS=3
BLOCK_HEAVY_ASSETS=1

# Pipeline limits (cost and memory guards).
INITIAL_BATCH_SIZE=10
CHUNK_SIZE=3
MAX_POSTS_PER_URL=200
MAX_POST_CHARS=4000

# Network safety. Only enable for local development against a trusted host.
ALLOW_PRIVATE_HOSTS=0

# Persistence.
PERSIST_INSIGHTS=0
INSIGHTS_PATH=./insights.json
MAX_STORED_INSIGHTS=1000

# error | warn | info | debug
LOG_LEVEL=info
LOG_FORMAT=pretty
