# Provider: openai (default) or github-models.
# github-models uses your GitHub account instead of an OpenAI key. It reads GITHUB_TOKEN /
# GH_TOKEN, and otherwise falls back to your GitHub CLI login (`gh auth login`).
# The token needs the "models:read" scope.
LLM_PROVIDER=openai

# Required when LLM_PROVIDER=openai. Never commit the real value.
OPENAI_API_KEY=sk-your-key-here

# Required when LLM_PROVIDER=github-models and the GitHub CLI is not installed.
# GITHUB_TOKEN=ghp_your-token-here

# Optional: point at a compatible gateway. Defaults to the selected provider's endpoint
# (https://api.openai.com/v1 or https://models.github.ai/inference).
OPENAI_BASE_URL=https://api.openai.com/v1

# Models per pipeline stage. Defaults follow the provider; GitHub Models requires
# publisher-qualified names such as openai/gpt-4o-mini.
MODEL_EXTRACTION=gpt-4o-mini
MODEL_ANALYSIS=gpt-4o-mini
MODEL_IDEAS=gpt-4o-mini
MODEL_RANKING=gpt-4o

# LLM transport.
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=4
LLM_CONCURRENCY=4

# Browser.
SHOW_BROWSER=1
NAV_TIMEOUT_MS=20000
MAX_SCROLLS=3
BLOCK_HEAVY_ASSETS=1

# Pipeline limits (cost and memory guards).
INITIAL_BATCH_SIZE=10
CHUNK_SIZE=3
MAX_POSTS_PER_URL=200
MAX_POST_CHARS=4000

# Network safety. Only enable for local development against a trusted host.
ALLOW_PRIVATE_HOSTS=0

# Persistence.
PERSIST_INSIGHTS=0
INSIGHTS_PATH=./insights.json
MAX_STORED_INSIGHTS=1000

# error | warn | info | debug
LOG_LEVEL=info
LOG_FORMAT=pretty
