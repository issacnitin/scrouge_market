{
  "name": "scrouge-market",
  "version": "1.0.0",
  "description": "AI-powered CLI agent that browses URLs, extracts user posts, and generates ranked product ideas.",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "bin": {
    "scrouge": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "browsers": "playwright install chromium",
    "verify": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "playwright": "^1.58.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^2.1.8"
  }
}
